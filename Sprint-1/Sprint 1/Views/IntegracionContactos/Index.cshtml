@model PrototipoCompras.Models.ContactosApiResultadoViewModel

@{
    ViewData["Title"] = "API Contactos";
}

<div class="mb-4">
    <h2 class="fw-bold">📇 Contactos externos</h2>
    <p class="text-muted mb-0">Consumo autenticado del módulo de proveedores/contactos.</p>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        Lista de contactos
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-danger">
                <strong>Error:</strong> @Model.Error
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.RawResponse))
            {
                <details>
                    <summary>Ver respuesta cruda de la API</summary>
                    <pre style="white-space: pre-wrap;">@Model.RawResponse</pre>
                </details>
            }
        }
        else if (Model.Contactos.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Contacto</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Empresa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Contactos)
                        {
                            <tr>
                                <td>@item.IdContacto</td>
                                <td>@item.NombreCompleto</td>
                                <td>@item.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Telefono) ? "-" : item.Telefono)</td>
                                <td>@item.EmpresaNombre</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                La API respondió sin registros.
            </div>
        }
    </div>
</div>